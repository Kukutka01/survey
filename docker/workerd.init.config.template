# Одноразовый init-воркер: открывает D1 (/data/survey-db.sqlite), применяет
# docker/migrations.sql. Запускается entrypoint.sh до основного сервера:
# workerd в standalone-режиму требует хотя бы один socket, поэтому используется
# служебный ephemeral-порт INIT_PORT, после чего процесс завершается по timeout.
using Workerd = import "/workerd/workerd.capnp";

const config :Workerd.Config = (
  services = [name = "main", worker = surveyInit],
  sockets = [
    ( name = "http",
      address = "127.0.0.1:${INIT_PORT}",
      http = true,
      service = "main"
    )
  ]
);

const surveyInit :Workerd.Worker = (
  compatibilityDate = "2026-09-01",
  bindings = [
    ( name = "DB",
      durableSqlStorage = ( disk = ( path = "/data/survey-db.sqlite", schema = "v1" ) )
    ),
    ( name = "MIGRATIONS_SQL", type = "text", data = embed "./docker/migrations.sql")
  ],
  modules = [
    ( name = "init.js",
      esModule = embed "./docker/init-worker.mjs"
    )
  ]
);
