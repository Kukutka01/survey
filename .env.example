# ОБЯЗАТЕЛЬНЫЕ секреты (вне Git! права 600). Генерация: openssl rand -base64 32
SURVEY_SIGNING_KEY=
VK_ENCRYPTION_KEY=

# Опционально: IP доверенных прокси через запятую (например nginx перед контейнером).
# Пока пусто — заголовок X-Forwarded-For игнорируется полностью (XFF-spoofing невозможен),
# но rate-limit по IP опирается на cf-connecting-ip/x-real-ip.
TRUSTED_PROXIES=

# Админка /admin (ОПЦИОНАЛЬНО, но рекомендуется). Пусто => админка отключена.
# Минимум 12 символов. 5 неудачных попыток входа / 10 минут на IP.
ADMIN_PASSWORD=
